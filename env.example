PORT=8000
CORS_ORIGIN=http://localhost:5173,https://noladseng.com,https://www.noladseng.com

# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-SIDE ONLY — Never expose this to the browser / client bundle
# Do NOT prefix server-only keys with VITE_
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE=your-supabase-service-role-key

UPLOAD_MAX_SIZE=10mb

# ------------------------------------------------------------------
# Google Analytics 4
# ------------------------------------------------------------------
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Data API credentials (server-side reporting dashboard)
GA4_PROPERTY_ID=your_ga4_numeric_property_id
GA4_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-content\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------
# PostHog Analytics (free alternative — 1M events/month free)
# https://app.posthog.com → Settings → Project API key
# ------------------------------------------------------------------
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
# Optional: EU data residency → https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------------
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=sales@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Nolads Engineering <sales@yourdomain.com>"
CONTACT_RECIPIENT=sales@yourdomain.com
QUOTES_RECIPIENT=sales@yourdomain.com
